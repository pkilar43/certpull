#!/usr/bin/env bash
# certpull-host -- host management on the server side.
#
#   certpull-host add [--csr] <hostid> <domain> [domain...]  add a host + show CNAMEs
#   certpull-host cname <hostid>                       show the records to paste
#   certpull-host key <hostid>[,<hostid>...] '<key>'   authorise an agent key
#                                                      (reusing it overwrites the list)
#   certpull-host del <hostid>                         remove a host (conf, key, pull)
#   certpull-host list                                 hosts, mode and domains
#   certpull-host keys                                 keys and what they may fetch
#   certpull-host csr [<hostid>]                       state of the submitted CSRs
#   certpull-host csr-import <hostid> [file]           accept a CSR out-of-band
#                                                      (file or stdin)
#   certpull-host token [--rotate] <hostid>            HTTPS path token
#   certpull-host url <hostid>                         the URL an agent uses
#   certpull-host doctor                               diagnose the SSH account
#
# --csr puts the host in CSR mode: the agent generates its own private key and
# submits a CSR, and this server never holds the private key. Without it the
# server generates the key, as it always has.
#
# csr-import exists for a host that cannot reach this server over SSH at all:
# it prints its CSR with `certpull-agent --print-csr`, you bring that one file
# here once per key, and from then on the host fetches over anonymous HTTPS.
set -euo pipefail

CONF="${CERTPULL_CONF:-/etc/certpull/certpull.conf}"
LIBDIR="$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)"
# shellcheck source=/dev/null
source "$CONF"
: "${HOSTS_DIR:=/etc/certpull/hosts.d}" "${PULL_DIR:=/var/lib/certpull/pull}"
: "${ACME_ZONE:?}" "${DEFAULT_KEY_TYPE:=ec256}"
: "${CSR_DIR:=/var/lib/certpull/csr}"
: "${WWW_DIR:=/var/lib/certpull/www}" "${WWW_BASE_URL:=}"
GLOBAL_ACME_ZONE="$ACME_ZONE"

AUTHKEYS="/var/lib/certpull/.ssh/authorized_keys"
SHELLBIN="/usr/local/lib/certpull/certpull-pull-shell"

usage() { sed -n '3,26p' "$0"; exit 2; }
die()   { echo "certpull-host: $*" >&2; exit 1; }

load_lib() {                 # $1 = file name
  local l
  for l in "$LIBDIR/$1" "/usr/local/lib/certpull/$1"; do
    if [[ -r $l ]]; then
      # shellcheck source=/dev/null
      source "$l"; return 0
    fi
  done
  die "$1 not found (run install-server.sh --update)"
}
load_csrlib() { load_lib certpull-csrlib.sh; }
load_wwwlib() { load_lib certpull-wwwlib.sh; }

host_mode() {                # $1 = hostid -> csr|full
  local m
  m=$( set +u
       CSR_MODE=""
       # shellcheck source=/dev/null
       source "$HOSTS_DIR/$1.conf" >/dev/null 2>&1 || true
       printf '%s' "${CSR_MODE,,}" )
  if [[ $m == yes ]]; then printf 'csr'; else printf 'full'; fi
}

valid_id() { [[ $1 =~ ^[a-z0-9][a-z0-9._-]*$ ]] || die "a hostid may only contain [a-z0-9._-]"; }

cmd="${1:-}"; shift || usage

case "$cmd" in

add)
  zone_override=""; csr_mode="no"
  while :; do
    case "${1:-}" in
      --zone) zone_override="${2:-}"; shift 2 ;;
      --csr)  csr_mode="yes"; shift ;;
      *) break ;;
    esac
  done
  hostid="${1:-}"; shift || usage
  valid_id "$hostid"
  (($#)) || die "give at least one domain"
  if [[ -e $HOSTS_DIR/$hostid.conf ]]; then die "$hostid already exists"; fi
  mkdir -p "$HOSTS_DIR"
  cat > "$HOSTS_DIR/$hostid.conf" <<EOF
DOMAINS="$*"
KEY_TYPE=""
RENEW_DAYS=""
ENABLED="yes"
# The zone this host's _acme-challenge CNAME points into.
# Empty = ACME_ZONE from /etc/certpull/certpull.conf
ACME_ZONE="$zone_override"
# yes = the agent generates its own private key and submits a CSR; this server
#       signs it and never holds the private key. Requires an agent that knows
#       the "submit" verb.
CSR_MODE="$csr_mode"
# Random path component for publishing the PUBLIC bundle over HTTPS. Not a
# password -- it only stops a stranger enumerating the fleet. Unused unless
# WWW_BASE_URL is set in certpull.conf and this host is in CSR mode.
WWW_TOKEN="$(openssl rand -hex 16)"
EOF
  chmod 0644 "$HOSTS_DIR/$hostid.conf"
  echo "created $HOSTS_DIR/$hostid.conf (mode: $( [[ $csr_mode == yes ]] && echo csr || echo full ))"
  if [[ $csr_mode == yes ]]; then
    echo
    echo "CSR mode: nothing will be issued until the agent submits a CSR."
    echo "On the LAN machine, after install-agent.sh --csr:"
    echo "    certpull-agent --submit"
    echo "then here:"
    echo "    certpull-issue $hostid"
    load_wwwlib
    if www_enabled; then
      DOMAINS="$*"
      www_write_config "$hostid" "$DOMAINS" csr "" || true
      echo
      echo "HTTPS publishing is on, so this host can skip SSH entirely:"
      echo "    on the LAN machine:  ./install-agent.sh --https $(www_url "$hostid")"
      echo "                         certpull-agent --print-csr"
      echo "    bring that CSR here: certpull-host csr-import $hostid <file>"
      echo "                         certpull-issue $hostid"
    fi
  fi
  echo
  exec "$0" cname "$hostid"
  ;;

cname)
  hostid="${1:-}"; valid_id "$hostid"
  [[ -r $HOSTS_DIR/$hostid.conf ]] || die "no $HOSTS_DIR/$hostid.conf"
  DOMAINS=""; ACME_ZONE=""
  # shellcheck source=/dev/null
  source "$HOSTS_DIR/$hostid.conf"
  zone="${ACME_ZONE:-$GLOBAL_ACME_ZONE}"
  # read -ra, not an unquoted expansion: a wildcard domain would otherwise be
  # pathname-expanded against the current directory.
  declare -a dlist=(); read -r -a dlist <<<"$DOMAINS"
  echo "Paste into the public zones (once; nothing changes afterwards):"
  echo
  for d in "${dlist[@]}"; do
    base="${d#\*.}"
    printf '  _acme-challenge.%s.\t300\tIN\tCNAME\t%s.%s.\n' "$base" "$base" "$zone"
  done
  echo
  echo "Verify once propagated:"
  for d in "${dlist[@]}"; do
    base="${d#\*.}"
    printf '  dig +short CNAME _acme-challenge.%s\n' "$base"
  done
  ;;

key)
  # certpull-host key <hostid>[,<hostid>...] "<public key>"
  # If the key is already in authorized_keys, its hostid list is OVERWRITTEN
  # with the value given here -- that is how access to further certificates is
  # granted and revoked.
  ids_raw="${1:-}"; [[ -n $ids_raw ]] || usage
  pub="${2:-}"; [[ -n $pub ]] || die "pass the public key in quotes"

  IFS=', ' read -r -a ids <<<"$ids_raw"
  ((${#ids[@]})) || die "empty hostid list"
  for h in "${ids[@]}"; do
    valid_id "$h"
    [[ -r $HOSTS_DIR/$h.conf ]] || die "first run: certpull-host add $h <domains>"
  done

  # keep only type+base64 (drop any trailing comment)
  read -r ktype kdata _ <<<"$pub"
  [[ $ktype =~ ^(ssh-ed25519|ecdsa-sha2-nistp(256|384|521)|ssh-rsa|sk-ssh-ed25519@openssh\.com)$ ]] \
    || die "unsupported key type: $ktype"

  mkdir -p "$(dirname "$AUTHKEYS")"; touch "$AUTHKEYS"
  newline=$(printf 'restrict,command="%s %s" %s %s certpull-%s' \
              "$SHELLBIN" "${ids[*]}" "$ktype" "$kdata" "${ids[0]}")

  tmp=$(mktemp); found=0; old=""
  while IFS= read -r line || [[ -n $line ]]; do
    if [[ $line == *" $kdata"* ]]; then
      found=1
      old="${line#*certpull-pull-shell }"; old="${old%%\"*}"
      printf '%s\n' "$newline" >> "$tmp"
    else
      printf '%s\n' "$line" >> "$tmp"
    fi
  done < "$AUTHKEYS"
  if (( ! found )); then printf '%s\n' "$newline" >> "$tmp"; fi
  cat "$tmp" > "$AUTHKEYS"; rm -f "$tmp"

  chown -R certpull:certpull "$(dirname "$AUTHKEYS")"
  chmod 0700 "$(dirname "$AUTHKEYS")"; chmod 0600 "$AUTHKEYS"
  if (( found )); then
    echo "updated an existing key: [$old] -> [${ids[*]}]"
  else
    echo "added a key with access to: ${ids[*]}"
  fi
  ;;

del)
  hostid="${1:-}"; valid_id "$hostid"
  rm -f "$HOSTS_DIR/$hostid.conf"
  rm -rf "${PULL_DIR:?}/$hostid"
  rm -f "${CSR_DIR:?}/$hostid.csr"
  load_wwwlib; www_remove "$hostid"
  # drop the hostid from the lists in authorized_keys; remove the whole line
  # only once its list becomes empty
  if [[ -s $AUTHKEYS ]]; then
    tmp=$(mktemp)
    while IFS= read -r line || [[ -n $line ]]; do
      if [[ $line != *"certpull-pull-shell "* ]]; then
        printf '%s\n' "$line" >> "$tmp"; continue
      fi
      head="${line%%certpull-pull-shell *}"
      rest="${line#*certpull-pull-shell }"
      ids_str="${rest%%\"*}"; tail_str="${rest#*\"}"
      keep=()
      for h in $ids_str; do if [[ $h != "$hostid" ]]; then keep+=( "$h" ); fi; done
      if ((${#keep[@]})); then
        printf '%scertpull-pull-shell %s"%s\n' "$head" "${keep[*]}" "$tail_str" >> "$tmp"
      fi
    done < "$AUTHKEYS"
    cat "$tmp" > "$AUTHKEYS"; rm -f "$tmp"
    chmod 0600 "$AUTHKEYS"
  fi
  echo "removed $hostid (the certificate stays in lego's store -- delete it by hand if needed)"
  ;;

list)
  shopt -s nullglob
  for f in "$HOSTS_DIR"/*.conf; do
    hostid=$(basename "$f" .conf); DOMAINS=""; ENABLED="yes"; CSR_MODE=""; WWW_TOKEN=""
    # shellcheck source=/dev/null
    source "$f"
    haskey=no
    if grep -qE "certpull-pull-shell [^\"]*\b${hostid//./\\.}\b" "$AUTHKEYS" 2>/dev/null; then haskey=yes; fi
    mode=full; if [[ ${CSR_MODE,,} == yes ]]; then mode=csr; fi
    csrst=""
    if [[ $mode == csr ]]; then
      if [[ -s $CSR_DIR/$hostid.csr ]]; then csrst=" csr=ok"; else csrst=" csr=MISSING"; fi
    fi
    wwwst=""
    if [[ $mode == csr ]] && [[ -n ${WWW_BASE_URL:-} ]]; then
      if [[ -n ${WWW_TOKEN:-} && -s $WWW_DIR/$hostid-$WWW_TOKEN/fullchain.pem ]]; then
        wwwst=" https=ok"
      elif [[ -n ${WWW_TOKEN:-} ]]; then wwwst=" https=pending"
      else wwwst=" https=NOTOKEN"; fi
    fi
    printf '%-22s mode=%-5s enabled=%-4s key=%-4s%s%s %s\n' \
      "$hostid" "$mode" "$ENABLED" "$haskey" "$csrst" "$wwwst" "$DOMAINS"
  done
  ;;

csr)
  # What the agents have submitted, and whether it still matches DOMAINS.
  load_csrlib
  shopt -s nullglob
  if [[ -n ${1:-} ]]; then valid_id "$1"; files=( "$HOSTS_DIR/$1.conf" ); else files=( "$HOSTS_DIR"/*.conf ); fi
  (( ${#files[@]} )) || { echo "(no hosts)"; exit 0; }
  for f in "${files[@]}"; do
    [[ -r $f ]] || die "no $f"
    hostid=$(basename "$f" .conf); DOMAINS=""; CSR_MODE=""
    # shellcheck source=/dev/null
    source "$f"
    if [[ ${CSR_MODE,,} != yes ]]; then
      printf '%-22s full mode -- the server holds the key\n' "$hostid"
      continue
    fi
    c="$CSR_DIR/$hostid.csr"
    if [[ ! -s $c ]]; then
      printf '%-22s NO CSR YET -- run certpull-agent --submit on the LAN host\n' "$hostid"
      continue
    fi
    if out=$(csr_check "$c" "$DOMAINS" 2>&1); then
      printf '%-22s ok   spki=%s  names=%s\n' "$hostid" "$(csr_spki_sha256 "$c")" "$(csr_names "$c" | tr '\n' ' ')"
    else
      printf '%-22s STALE/INVALID\n' "$hostid"
      printf '%s\n' "$out" | sed 's/^/                       /'
    fi
  done
  ;;

csr-import)
  # For a host that cannot reach this server over SSH at all. The CSR goes
  # through exactly the same authorisation check as a submitted one -- being
  # carried by a human does not make its names trustworthy.
  hostid="${1:-}"; valid_id "$hostid"
  src="${2:--}"
  [[ -r $HOSTS_DIR/$hostid.conf ]] || die "no $HOSTS_DIR/$hostid.conf"
  DOMAINS=""; CSR_MODE=""
  # shellcheck source=/dev/null
  source "$HOSTS_DIR/$hostid.conf"
  [[ ${CSR_MODE,,} == yes ]] || die "$hostid is not in CSR mode (set CSR_MODE=\"yes\" first)"
  load_csrlib
  tmp=$(mktemp); trap 'rm -f "$tmp"' EXIT
  if [[ $src == - ]]; then
    head -c "$CERTPULL_CSR_MAX_BYTES" > "$tmp"
  else
    [[ -r $src ]] || die "cannot read $src"
    head -c "$CERTPULL_CSR_MAX_BYTES" < "$src" > "$tmp"
  fi
  csr_check "$tmp" "$DOMAINS" || die "the CSR was rejected (see above)"
  install -d -m 0700 -o certpull -g certpull "$CSR_DIR" 2>/dev/null || mkdir -p "$CSR_DIR"
  install -m 0600 "$tmp" "$CSR_DIR/.staged.$hostid"
  mv -f "$CSR_DIR/.staged.$hostid" "$CSR_DIR/$hostid.csr"
  chown certpull:certpull "$CSR_DIR/$hostid.csr" 2>/dev/null || true
  echo "imported a CSR for $hostid (spki $(csr_spki_sha256 "$CSR_DIR/$hostid.csr"))"
  echo "now issue it:  certpull-issue $hostid"
  ;;

token)
  rotate=0
  if [[ ${1:-} == --rotate ]]; then rotate=1; shift; fi
  hostid="${1:-}"; valid_id "$hostid"
  [[ -r $HOSTS_DIR/$hostid.conf ]] || die "no $HOSTS_DIR/$hostid.conf"
  load_wwwlib
  cur="$(www_token_of "$hostid")"
  if (( rotate )) || [[ -z $cur ]]; then
    # The old directory goes away first: leaving it behind would keep the
    # previous URL working for as long as nobody noticed.
    www_remove "$hostid"
    new="$(www_new_token)"
    www_set_token "$hostid" "$new" || die "could not update $HOSTS_DIR/$hostid.conf"
    if (( rotate )); then
      echo "rotated the token for $hostid -- the old URL stops working now"
    else
      echo "created a token for $hostid"
    fi
    cur="$new"
  fi
  if www_enabled; then
    echo "url: $(www_url "$hostid")"
    echo "re-publish it with:  certpull-issue --force $hostid"
    echo "and on the LAN machine set:  CERT_URL=\"$(www_url "$hostid")\""
  else
    echo "token: $cur   (WWW_BASE_URL is not set, so nothing is published over HTTPS)"
  fi
  ;;

url)
  hostid="${1:-}"; valid_id "$hostid"
  [[ -r $HOSTS_DIR/$hostid.conf ]] || die "no $HOSTS_DIR/$hostid.conf"
  load_wwwlib
  www_enabled || die "WWW_BASE_URL is not set in $CONF -- HTTPS publishing is off"
  u="$(www_url "$hostid")"
  [[ -n $u ]] || die "$hostid has no WWW_TOKEN -- run: certpull-host token $hostid"
  printf '%s\n' "$u"
  ;;

doctor)
  # checks everything that must be true for an agent to be able to log in
  rc=0
  ok()   { printf '  [ OK ] %s\n' "$*"; }
  bad()  { printf '  [FAIL] %s\n' "$*"; rc=1; }
  warn() { printf '  [ ?? ] %s\n' "$*"; }

  echo "certpull account:"
  if ! id -u certpull >/dev/null 2>&1; then
    bad "user certpull does not exist"
  else
    ok "user exists"
    sh=$(getent passwd certpull | cut -d: -f7)
    case "$sh" in
      */nologin|*/false)
        bad "the shell is $sh -- sshd runs the forced command through the login shell,"
        echo "         so nologin kills the connection with"
        echo "         'This account is currently not available.' before pull-shell starts."
        echo "         fix:  usermod -s /bin/bash certpull" ;;
      "") bad "no shell in /etc/passwd" ;;
      *)  if [[ -x $sh ]]; then ok "shell $sh"; else bad "shell $sh is missing or not executable"; fi ;;
    esac
    hd=$(getent passwd certpull | cut -d: -f6)
    [[ -d $hd ]] && ok "home directory $hd" || bad "home directory $hd is missing"
  fi

  echo "authorized_keys:"
  if [[ ! -s $AUTHKEYS ]]; then
    warn "$AUTHKEYS is empty or missing -- no agent will be able to log in"
  else
    ok "$AUTHKEYS ($(grep -c 'certpull-pull-shell' "$AUTHKEYS" 2>/dev/null || echo 0) keys)"
    p=$(stat -c '%a %U:%G' "$AUTHKEYS")
    [[ $p == "600 certpull:certpull" ]] && ok "permissions $p" || bad "permissions $p (expected 600 certpull:certpull)"
    pd=$(stat -c '%a %U:%G' "$(dirname "$AUTHKEYS")")
    [[ $pd == "700 certpull:certpull" ]] && ok ".ssh directory $pd" || bad ".ssh directory $pd (expected 700 certpull:certpull)"
  fi

  echo "forced command:"
  if [[ -x $SHELLBIN ]]; then ok "$SHELLBIN"; else bad "$SHELLBIN is missing or not executable"; fi

  echo "sshd:"
  if sshd -T -C "user=certpull,host=localhost,addr=127.0.0.1" >/dev/null 2>&1; then
    akf=$(sshd -T -C "user=certpull,host=localhost,addr=127.0.0.1" 2>/dev/null | awk '/^authorizedkeysfile/{print $2}')
    ok "configuration parses; authorizedkeysfile=${akf:-?}"
  else
    warn "cannot query sshd -T (run as root)"
  fi

  echo "pull directory:"
  if [[ -d $PULL_DIR ]]; then
    n=$(find "$PULL_DIR" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l)
    ok "$PULL_DIR ($n published certificates)"
  else
    bad "$PULL_DIR is missing"
  fi

  echo "CSR mode:"
  if [[ -r $LIBDIR/certpull-csrlib.sh || -r /usr/local/lib/certpull/certpull-csrlib.sh ]]; then
    ok "certpull-csrlib.sh is installed"
  else
    bad "certpull-csrlib.sh is missing -- the submit verb cannot work"
    echo "         fix:  ./install-server.sh --update"
  fi
  if [[ -d $CSR_DIR ]]; then
    pc=$(stat -c '%a %U:%G' "$CSR_DIR")
    if [[ $pc == "700 certpull:certpull" ]]; then
      ok "$CSR_DIR ($pc, $(find "$CSR_DIR" -maxdepth 1 -name '*.csr' 2>/dev/null | wc -l) CSRs)"
    else
      bad "$CSR_DIR is $pc (expected 700 certpull:certpull)"
      echo "         the certpull account writes submitted CSRs there"
      echo "         fix:  ./install-server.sh --update"
    fi
  else
    warn "$CSR_DIR does not exist yet -- it is created on the first run or by install-server.sh --update"
  fi
  # The pull-shell reads DOMAINS out of the host files as the certpull account.
  if [[ -d $HOSTS_DIR ]]; then
    ph=$(stat -c '%a' "$HOSTS_DIR")
    case "$ph" in
      *[157]) ok "$HOSTS_DIR is traversable ($ph)" ;;
      *) bad "$HOSTS_DIR is $ph -- the certpull account cannot read DOMAINS, so CSR mode breaks"
         echo "         fix:  chmod 0755 $HOSTS_DIR" ;;
    esac
  fi
  if [[ -n ${WWW_BASE_URL:-} ]]; then
    echo "HTTPS publishing:"
    load_wwwlib
    if [[ -d $WWW_DIR ]]; then
      pw=$(stat -c '%a' "$WWW_DIR")
      case "$pw" in
        *[1357]) ok "$WWW_DIR is traversable ($pw)" ;;
        *) bad "$WWW_DIR is $pw -- the web server user cannot read it"
           echo "         fix:  chmod 0755 $WWW_DIR" ;;
      esac
      # The one thing that must never be true.
      leaked=$(find "$WWW_DIR" -type f \( -name 'privkey*' -o -name '*.key' -o -name 'combined*' \) 2>/dev/null || true)
      if [[ -n $leaked ]]; then
        bad "A PRIVATE KEY IS PUBLISHED OVER HTTPS -- remove it now:"
        printf '         %s\n' $leaked
      else
        ok "no private key anywhere under $WWW_DIR"
      fi
      orph=$(www_orphans || true)
      if [[ -n $orph ]]; then
        warn "directories no host claims any more (old tokens?): $(printf '%s ' $orph)"
        echo "         remove them by hand once you are sure"
      fi
    else
      warn "$WWW_DIR does not exist yet -- it appears on the first publish"
    fi
  fi

  # certpull-pull-shell runs as certpull and cannot read certpull.conf, so it
  # falls back to its own compiled-in defaults. If the paths here have been
  # moved, the forced command has to be told -- otherwise submit writes into a
  # directory certpull-issue never looks at, and fetch finds nothing.
  if [[ $PULL_DIR != /var/lib/certpull/pull ]]; then
    warn "PULL_DIR is $PULL_DIR, but the pull shell defaults to /var/lib/certpull/pull"
    echo "         set CERTPULL_PULL_DIR for the forced command, or keep the default"
  fi
  if [[ $CSR_DIR != /var/lib/certpull/csr ]]; then
    warn "CSR_DIR is $CSR_DIR, but the pull shell defaults to /var/lib/certpull/csr"
    echo "         set CERTPULL_CSR_DIR for the forced command, or keep the default"
  fi
  if [[ $HOSTS_DIR != /etc/certpull/hosts.d ]]; then
    warn "HOSTS_DIR is $HOSTS_DIR, but the pull shell defaults to /etc/certpull/hosts.d"
    echo "         set CERTPULL_HOSTS_DIR for the forced command, or keep the default"
  fi

  echo
  if (( rc )); then echo "There are problems -- fix the above."; else echo "All good."; fi
  exit "$rc"
  ;;

keys)
  # who has access to what
  [[ -s $AUTHKEYS ]] || { echo "(no keys)"; exit 0; }
  while IFS= read -r line || [[ -n $line ]]; do
    [[ $line == *"certpull-pull-shell "* ]] || continue
    rest="${line#*certpull-pull-shell }"; ids_str="${rest%%\"*}"
    comment="${line##* }"
    printf '%-28s -> %s\n' "$comment" "$ids_str"
  done < "$AUTHKEYS"
  ;;

*) usage ;;
esac
