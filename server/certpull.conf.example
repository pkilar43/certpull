# /etc/certpull/certpull.conf  --  global configuration of the certpull server
# shellcheck shell=bash

# --- ACME -------------------------------------------------------------------
ACME_EMAIL="pki@example.com"
# production:
ACME_SERVER="https://acme-v02.api.letsencrypt.org/directory"
# staging (use it for testing, no rate limits):
# ACME_SERVER="https://acme-staging-v02.api.letsencrypt.org/directory"

# --- Delegated zone ---------------------------------------------------------
# The DEFAULT zone -- the one this host serves authoritatively and the one we
# point _acme-challenge records of production domains at, via CNAME.
#
# A single zone serves any number of domains: the CNAME target does NOT have
# to live in the same domain as the name being validated. You only add further
# zones when you want a separate delegation per client -- `certpull-zone add`.
# Per-host override: ACME_ZONE in /etc/certpull/hosts.d/<id>.conf.
ACME_ZONE="acme.example.com"

# The NS name pointing at this host -- used by `certpull-zone add` when it
# generates the SOA/NS of a new zone. Its A/AAAA record exists exactly once,
# in whichever domain that name lives in.
ACME_NS_NAME="ns-certpull.example.com"

# DNS server accepting dynamic updates (RFC2136). Knot on localhost.
DNS_SERVER="127.0.0.1"
DNS_PORT="53"

# TSIG key (file generated by install-server.sh; holds name/alg/secret)
TSIG_FILE="/etc/certpull/tsig.env"

# --- Renewal ----------------------------------------------------------------
# Renew when fewer than this many days remain before expiry.
# Let's Encrypt is shortening certificate lifetimes to 45 days, so 15 days is
# a safe threshold (about one third of the validity period).
RENEW_DAYS="15"

# Default key type for new hosts: ec256 | ec384 | rsa2048 | rsa4096
DEFAULT_KEY_TYPE="ec256"

# Seconds to wait after writing the TXT record before lego queries the
# authoritative servers. 0 = let lego run its own propagation check
# (recommended, since the zone is ours).
PROPAGATION_WAIT="0"

# RECURSIVE resolvers lego uses to resolve the _acme-challenge CNAME and to
# check propagation. We pass them explicitly because /etc/resolv.conf on this
# machine may point at 127.0.0.1 -- and Knot is authoritative, not recursive,
# so it answers REFUSED. lego would then conclude there is no CNAME and try to
# update the original name instead (the "code=REFUSED" failure).
# NEVER put 127.0.0.1 here.
DNS_RESOLVERS="8.8.8.8:53,9.9.9.9:53"

# Check propagation against RECURSIVE resolvers (--dns.propagation-rns) rather
# than against our own authoritative server. lego's default is to ask Knot
# directly -- which will always answer "the record is there", even when the
# public recursive path is broken, and only then does Let's Encrypt come back
# with "No TXT record found". Set this to "no" only for split-DNS or a hidden
# master setup.
PROPAGATION_RNS="yes"

# Before every validation, delete leftover TXT records under the CNAME target.
# lego issues "update add", not "replace": if a previous run was interrupted
# (Ctrl-C while waiting, a timeout, a killed process), the old token stays in
# the zone. The new one is added next to it, and resolvers that cached the old
# RRset keep serving it for its full TTL -- so Let's Encrypt sees a set that
# does not contain its own token. Leave this at "yes" unless you deliberately
# keep your own TXT records under that name.
PURGE_STALE_TXT="yes"

# --- Paths ------------------------------------------------------------------
HOSTS_DIR="/etc/certpull/hosts.d"
LEGO_DIR="/var/lib/certpull/lego"     # lego's internal state (ACME account, certs)
PULL_DIR="/var/lib/certpull/pull"     # what the agents can see over SSH
LOG_TAG="certpull"

# --- Notifications (optional) ----------------------------------------------
# Called when a renewal fails. Receives: $1=hostid $2=message
# NOTIFY_CMD="/usr/local/lib/certpull/notify-mail"
