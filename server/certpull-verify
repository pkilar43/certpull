#!/usr/bin/env bash
# certpull-verify -- end-to-end delegation test, without involving Let's Encrypt.
#
#   certpull-verify <hostid>              every domain of that host
#   certpull-verify <domain>              a single name
#   certpull-verify --all                 every host
#
# WHY THIS EXISTS
# By default lego checks propagation by asking the AUTHORITATIVE server
# directly (--dns.propagation-disable-ans turns that off). Let's Encrypt
# resolves the name RECURSIVELY, from several network perspectives (MPIC).
# That is why lego can report "propagation OK" and Let's Encrypt answer
# "No TXT record found" moments later -- the difference is in the recursive
# path: a missing or incomplete NS delegation, a dead AAAA record on the NS,
# a geo filter or firewall, or negative caching.
#
# WHAT THIS SCRIPT DOES
#   1. checks the _acme-challenge CNAME and whether its target is in our zone
#   2. checks that EVERY address (A and AAAA) of the NS really answers
#   3. writes a test TXT record via nsupdate/TSIG -- exactly like lego does
#   4. queries several public resolvers RECURSIVELY for it, following the CNAME
#   5. deletes the test TXT record
#
# No step touches Let's Encrypt, so it consumes no rate limits at all.
set -Eeuo pipefail

CONF="${CERTPULL_CONF:-/etc/certpull/certpull.conf}"
# shellcheck source=/dev/null
source "$CONF"
: "${ACME_ZONE:?}" "${DNS_SERVER:=127.0.0.1}" "${DNS_PORT:=53}"
: "${HOSTS_DIR:=/etc/certpull/hosts.d}" "${TSIG_FILE:=/etc/certpull/tsig.env}"
: "${DNS_RESOLVERS:=8.8.8.8:53,9.9.9.9:53}"
GLOBAL_ACME_ZONE="$ACME_ZONE"

# Resolvers used for the recursive test -- deliberately more than lego uses,
# to catch the "one sees it, another does not" case.
PUBLIC_RESOLVERS="${CERTPULL_TEST_RESOLVERS:-8.8.8.8 9.9.9.9 1.1.1.1 208.67.222.222}"
TRIES="${CERTPULL_VERIFY_TRIES:-6}"     # number of attempts
INTERVAL="${CERTPULL_VERIFY_INTERVAL:-5}"

RC=0
ok()   { printf '    \033[32mOK\033[0m   %s\n' "$*"; }
bad()  { printf '    \033[31mFAIL\033[0m %s\n' "$*"; RC=1; }
warn() { printf '    \033[33m??\033[0m   %s\n' "$*"; }
hdr()  { printf '\n== %s\n' "$*"; }

need() { command -v "$1" >/dev/null || { echo "missing command $1 (apt install $2)" >&2; exit 1; }; }
need dig dnsutils
need nsupdate knot-dnsutils

# --- TSIG key in a file (not in argv -- the secret must never reach ps) ------
# shellcheck source=/dev/null
source "$TSIG_FILE"
: "${TSIG_NAME:?}" "${TSIG_ALG:?}" "${TSIG_SECRET:?}"
KEYFILE=$(mktemp); chmod 0600 "$KEYFILE"
cat > "$KEYFILE" <<EOF
key "${TSIG_NAME%.}." {
    algorithm ${TSIG_ALG%.};
    secret "${TSIG_SECRET}";
};
EOF
trap 'rm -f "$KEYFILE"' EXIT

dig_status() {               # $1=server $2=type $3=name ; prints "STATUS aa|noaa"
  local resp st aa=noaa
  resp=$(dig "@$1" +noall +comments +time=3 +tries=2 "$2" "$3" 2>/dev/null) || true
  st=$(printf '%s' "$resp" | sed -n 's/.*status: \([A-Z]*\).*/\1/p' | head -1)
  if printf '%s' "$resp" | grep -qE '^;; flags:[^;]* aa[ ;]'; then aa=aa; fi
  printf '%s %s' "${st:-TIMEOUT}" "$aa"
}

# --- 2. does every address of the NS really answer? -------------------------
check_ns_addresses() {       # $1 = delegated zone
  local zone="$1" ns addrs a st tx
  hdr "authoritative servers of zone $zone"

  # An open transaction blocks dynamic updates -- lego would then only see
  # "DNS update failed: i/o timeout", because Knot stops answering rather
  # than refusing.
  if command -v knotc >/dev/null; then
    tx=$(knotc zone-status "$zone" +transaction 2>/dev/null || true)
    if [[ $tx == *open* ]]; then
      bad "$zone has an OPEN TRANSACTION -- updates are blocked"
      echo "         fix:  knotc zone-abort $zone"
    else
      ok "no dangling transaction"
    fi
  fi
  ns=$(dig +short NS "$zone" @"${PUBLIC_RESOLVERS%% *}" 2>/dev/null)
  if [[ -z $ns ]]; then
    bad "no publicly visible NS records for $zone -- the delegation is missing or has not propagated"
    echo "         check with the operator of the parent domain:  $zone. IN NS <ns-name>."
    return 1
  fi
  for n in $ns; do
    addrs=$(dig +short A "$n" @"${PUBLIC_RESOLVERS%% *}"; dig +short AAAA "$n" @"${PUBLIC_RESOLVERS%% *}")
    if [[ -z $addrs ]]; then
      bad "$n has neither an A nor an AAAA record"
      continue
    fi
    for a in $addrs; do
      read -r st _ <<<"$(dig_status "$a" SOA "$zone")"
      case "$st" in
        NOERROR)  ok  "$n [$a] answers authoritatively" ;;
        TIMEOUT)  bad "$n [$a] DOES NOT ANSWER -- that alone is enough for Let's Encrypt to fail validation"
                  case "$a" in
                    *:*) echo "         IPv6 address. Is Knot listening on ::@53 and does ufw allow 53 over IPv6?" ;;
                    *)   echo "         check the firewall (ufw allow 53) and whether knot is running" ;;
                  esac ;;
        *)        bad "$n [$a] answered $st to SOA $zone" ;;
      esac
    done
  done
}

# --- 3-5. full round trip of a test TXT record ------------------------------
check_domain() {             # $1 = domain (may be *.foo)  $2 = zone
  local d="${1#\*.}" zone="$2" chall target token got i seen
  chall="_acme-challenge.${d}"
  hdr "$d"

  target=$(dig +short +time=3 "@${PUBLIC_RESOLVERS%% *}" CNAME "$chall" 2>/dev/null | head -1)
  if [[ -z $target ]]; then
    bad "$chall: no CNAME"
    echo "         add:  $chall.  300 IN CNAME  ${d}.${zone}."
    return 1
  fi
  ok "CNAME -> $target"

  read -r st aa <<<"$(dig_status "$DNS_SERVER" SOA "$target")"
  if [[ $st == REFUSED || $aa != aa ]]; then
    bad "our Knot is not authoritative for the target ($st/$aa) -- certpull-zone list"
    return 1
  fi
  ok "the target lives in a locally served zone ($st, aa flag set)"

  token="certpull-verify-$$-${RANDOM}"
  if ! nsupdate -k "$KEYFILE" <<EOF >/dev/null 2>&1
server $DNS_SERVER $DNS_PORT
update add ${target} 60 TXT "$token"
send
EOF
  then
    bad "nsupdate could not write the test TXT -- check the TSIG key and the acl in knot.conf"
    return 1
  fi
  ok "test TXT written (it will be removed after the test)"

  # clean up no matter how the queries end
  cleanup_txt() {
    nsupdate -k "$KEYFILE" <<EOF >/dev/null 2>&1 || true
server $DNS_SERVER $DNS_PORT
update delete ${target} TXT
send
EOF
  }

  # locally, straight from Knot -- this is what lego checks
  got=$(dig +short "@$DNS_SERVER" -p "$DNS_PORT" TXT "$target" 2>/dev/null || true)
  if printf '%s' "$got" | grep -qF "$token"; then
    ok "Knot serves the TXT (this is what lego sees too)"
  else
    bad "Knot does NOT serve its own TXT -- a journal or zone problem"
    cleanup_txt; return 1
  fi

  # recursively, following the CNAME, from several places -- this is what LE does
  echo "    checking recursively (the way Let's Encrypt does), up to ${TRIES}x every ${INTERVAL}s:"
  for r in $PUBLIC_RESOLVERS; do
    seen=0
    for (( i=1; i<=TRIES; i++ )); do
      got=$(dig +short "@$r" +time=3 +tries=1 TXT "$chall" 2>/dev/null || true)
      if printf '%s' "$got" | grep -qF "$token"; then seen=1; break; fi
      sleep "$INTERVAL"
    done
    if (( seen )); then
      ok "$r sees the TXT after ${i} attempt(s)"
    else
      bad "$r does NOT see the TXT after $((TRIES*INTERVAL))s"
      echo "         this is exactly the situation in which Let's Encrypt returns"
      echo "         'No TXT record found at $chall'"
    fi
  done

  cleanup_txt
  ok "test TXT removed"
}

# --- main -------------------------------------------------------------------
# Sets the globals DOMS / ZONE_FOR_HOST / HOST_ENABLED.
# Deliberately NOT via $(...) -- a subshell would lose those variables.
load_host() {
  local f="$HOSTS_DIR/$1.conf"
  DOMS=""; ZONE_FOR_HOST="$GLOBAL_ACME_ZONE"; HOST_ENABLED="yes"
  [[ -r $f ]] || return 1
  DOMAINS=""; ACME_ZONE=""; ENABLED="yes"
  # shellcheck source=/dev/null
  source "$f"
  DOMS="$DOMAINS"
  ZONE_FOR_HOST="${ACME_ZONE:-$GLOBAL_ACME_ZONE}"
  HOST_ENABLED="$ENABLED"
  [[ -n $DOMS ]]
}

arg="${1:-}"
[[ -n $arg ]] || { sed -n '3,6p' "$0"; exit 2; }

declare -A ZONES_SEEN=()

run_for() {                  # $1=domain $2=zone
  if [[ -z ${ZONES_SEEN[$2]:-} ]]; then
    ZONES_SEEN[$2]=1
    check_ns_addresses "$2" || true
  fi
  check_domain "$1" "$2" || true
}

if [[ $arg == --all ]]; then
  shopt -s nullglob
  for f in "$HOSTS_DIR"/*.conf; do
    h=$(basename "$f" .conf)
    load_host "$h" || continue
    [[ ${HOST_ENABLED,,} == yes ]] || continue
    printf '\n######## %s\n' "$h"
    for d in $DOMS; do run_for "$d" "$ZONE_FOR_HOST"; done
  done
elif load_host "$arg"; then
  printf '\n######## %s\n' "$arg"
  for d in $DOMS; do run_for "$d" "$ZONE_FOR_HOST"; done
else
  run_for "$arg" "$GLOBAL_ACME_ZONE"
fi

echo
if (( RC )); then
  echo "There are failures -- the above has to work before lego has any chance of succeeding."
else
  echo "The whole recursive path works. certpull-issue should succeed."
fi
exit "$RC"
