# /etc/certpull/agent.conf -- agent configuration on a LAN machine
# shellcheck shell=bash

# Account and host of the certpull server.
SERVER="certpull@ns-certpull.example.com"
SERVER_PORT="22"

# Host identifier -- must match the file name in /etc/certpull/hosts.d on the
# server and the forced command in authorized_keys.
HOSTID="srv-web-01"

# The agent's SSH key (no passphrase; readable by root only).
SSH_KEY="/etc/certpull/id_ed25519"
KNOWN_HOSTS="/etc/certpull/known_hosts"

# Where to install the certificate.
DEST="/etc/ssl/certpull"

# File names in the destination directory:
#   pem     cert.pem  chain.pem  fullchain.pem  privkey.pem   (default)
#   crtkey  <hostid>.crt (full chain) + <hostid>.key
#           + <hostid>.chain.crt + <hostid>.leaf.crt
FILE_STYLE="pem"

# File ownership and permissions.
CERT_OWNER="root:root"
CERT_MODE="0644"
KEY_OWNER="root:root"
KEY_MODE="0600"

# Also write fullchain+key into a single file (HAProxy, Postfix, Dovecot).
COMBINED="no"

# Verification: the agent rejects a certificate that does not cover these
# names. Empty = check only what came in meta.json from the server.
EXPECT_DOMAINS=""

# --- Which side holds the private key ---------------------------------------
# Empty (recommended) = follow the server: it is the authority on whether this
#   host is in "full" or "csr" mode, and the agent adapts.
# "yes" / "no" turn this into an ASSERTION. A mismatch with the server then
#   becomes an error instead of a silent change of where the private key lives.
#
# csr mode means: this machine generates its own private key, the key never
# goes anywhere, and only a CSR is sent to the server. The first certificate
# needs one extra step -- `certpull-agent --submit` here, then
# `certpull-issue <hostid>` on the server -- after which the timers take over.
CSR_MODE=""

# --- Transport ---------------------------------------------------------------
# ssh    (default)  pull over an SSH forced command, as always
# https             anonymous GET of the published public bundle. Needs no SSH
#                   key and no outbound port 22, so it works where the only way
#                   out is an HTTP proxy on 443. CSR mode only -- what gets
#                   served contains no private key, which is why it needs no
#                   credentials at all: the agent accepts a bundle only if it
#                   chains to Let's Encrypt AND matches the private key here.
#
# Enrolment with https is a one-time out-of-band step, because the endpoint is
# read-only:  certpull-agent --print-csr  here, then on the server
#             certpull-host csr-import <hostid> <file> && certpull-issue <hostid>
TRANSPORT="ssh"

# https only: the URL from `certpull-host url <hostid>` on the server.
CERT_URL=""

# https only: an explicit outbound proxy, if that is the only way out.
# PROXY="http://proxy.example.com:3128"
PROXY=""

# The key this machine generates for itself in csr mode (ignored in full mode,
# where KEY_TYPE in the host file on the server decides).
# ec256 | ec384 | rsa2048 | rsa4096
AGENT_KEY_TYPE="ec256"

# Command to reload the service after the certificate is replaced.
# Several commands may be chained with ';'. If it returns an error, the agent
# rolls the replacement back.
RELOAD_CMD="apache2ctl configtest && systemctl reload apache2"

# Called after a failed cycle: $1=hostid $2=message  (optional)
# NOTIFY_CMD="/usr/local/lib/certpull/notify-mail"
