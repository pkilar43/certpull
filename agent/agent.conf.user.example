# ~/.config/certpull/agent.conf
# Dedicated-user mode. The agent detects it from UID != 0 and then assumes:
#
#   SSH key      ~/.ssh/id_ed25519
#   known_hosts  ~/.ssh/known_hosts
#   destination  ~/certificates          (mode 0700)
#   lock         $XDG_RUNTIME_DIR or ~/.cache/certpull
#
# Only what is genuinely host-specific needs to be set below. The rest are
# comments showing what can be overridden.
# shellcheck shell=bash

SERVER="certpull@ns-certpull.example.com"
SERVER_PORT="22"
HOSTID="srv-web-01"

# File names in the destination directory:
#   pem     cert.pem  chain.pem  fullchain.pem  privkey.pem   (default)
#   crtkey  <hostid>.crt (full chain) + <hostid>.key
#           + <hostid>.chain.crt + <hostid>.leaf.crt
FILE_STYLE="crtkey"

# The default paths are derived from $HOME -- uncomment only to change them.
# SSH_KEY="$HOME/.ssh/id_ed25519"
# KNOWN_HOSTS="$HOME/.ssh/known_hosts"
# DEST="$HOME/certificates"
# DEST_MODE="0700"

CERT_MODE="0644"
KEY_MODE="0600"

# Also write fullchain+key into a single file (HAProxy, Postfix, Dovecot).
COMBINED="no"

# The agent rejects a certificate that does not cover these names.
# Empty = check only what came in meta.json from the server.
EXPECT_DOMAINS=""

# --- Which side holds the private key ---------------------------------------
# Empty (recommended) = follow the server. "yes"/"no" make it an assertion, so
# a mismatch is an error rather than a silent move of the private key.
#
# csr mode: this machine generates its own key, it never leaves, and only a CSR
# goes to the server. First certificate:  certpull-agent --submit  here, then
# certpull-issue <hostid> on the server.
CSR_MODE=""

# --- Transport ---------------------------------------------------------------
# ssh    (default)  pull over an SSH forced command, as always
# https             anonymous GET of the published public bundle. Needs no SSH
#                   key and no outbound port 22, so it works where the only way
#                   out is an HTTP proxy on 443. CSR mode only -- what gets
#                   served contains no private key, which is why it needs no
#                   credentials at all: the agent accepts a bundle only if it
#                   chains to Let's Encrypt AND matches the private key here.
#
# Enrolment with https is a one-time out-of-band step, because the endpoint is
# read-only:  certpull-agent --print-csr  here, then on the server
#             certpull-host csr-import <hostid> <file> && certpull-issue <hostid>
TRANSPORT="ssh"

# https only: the URL from `certpull-host url <hostid>` on the server.
CERT_URL=""

# https only: an explicit outbound proxy, if that is the only way out.
# PROXY="http://proxy.example.com:3128"
PROXY=""

# The key this machine generates for itself in csr mode.
# ec256 | ec384 | rsa2048 | rsa4096
AGENT_KEY_TYPE="ec256"

# Service reload. Without root this needs passwordless sudo restricted to a
# single command -- the installer writes such a rule into /etc/sudoers.d/ when
# you pass --reload-unit. If the agent only drops the files off and something
# else reloads the service (a path unit, your own script), leave this empty.
RELOAD_CMD=""
# RELOAD_CMD="sudo -n /usr/bin/systemctl reload nginx"

# NOTIFY_CMD="$HOME/bin/certpull-notify"
