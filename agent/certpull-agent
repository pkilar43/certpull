#!/usr/bin/env bash
# certpull-agent -- fetches the certificate from the certpull server over SSH
# and installs it locally. Run from a timer on a LAN machine. Traffic only ever
# goes LAN -> internet, so the host does not need to be reachable from outside.
#
#   certpull-agent                -> fetch if the fingerprint changed
#   certpull-agent --force        -> fetch and reinstall unconditionally
#   certpull-agent --check        -> only show the state, change nothing
#   certpull-agent --remote-list  -> ask the server what this key may fetch
#   certpull-agent --submit       -> (CSR mode) generate the key if needed and
#                                    send a fresh CSR, then stop
#   certpull-agent --print-csr    -> (CSR mode) print the CSR on stdout for
#                                    out-of-band enrolment, change nothing else
#   certpull-agent --rotate-key   -> (CSR mode) make a NEW private key and ask
#                                    for a certificate on it; the old key stays
#                                    in use until the new certificate arrives
#
# Two transports, set with TRANSPORT in the configuration file:
#
#   ssh    (default)  the original pull over an SSH forced command
#   https             anonymous GET of the published public bundle. Needs no
#                     SSH key and no outbound port 22, so it works where the
#                     only way out is an HTTP proxy on 443. CSR mode only --
#                     there is no private key in what gets served. Enrolment is
#                     out-of-band: --print-csr here, csr-import on the server.
#
# It works in two modes, detected from the UID:
#
#   root                   config /etc/certpull/agent.conf (or agent.d/*.conf)
#                          key    /etc/certpull/id_ed25519
#                          target /etc/ssl/certpull
#
#   dedicated user         config ~/.config/certpull/agent.conf (or agent.d/*.conf)
#                          key    ~/.ssh/id_ed25519
#                          target ~/certificates
#
# Every one of those values can be overridden in the configuration file.
#
# Independently of that, the SERVER decides which of two certificate modes a
# host uses:
#
#   full   the server generates the private key and ships it together with the
#          certificate. This is the original behaviour.
#   csr    this machine generates its own private key, the key never leaves,
#          and only a CSR goes to the server. The server publishes the
#          certificate alone. A certificate is public data, so there is nothing
#          to protect in transit: it is authentic because it chains to Let's
#          Encrypt AND matches the private key sitting right here.
set -Eeuo pipefail

# --- who is running us ------------------------------------------------------
AM_ROOT=0; [[ $EUID -eq 0 ]] && AM_ROOT=1 || true
MYUSER="$(id -un)"
MYHOME="${HOME:-$(getent passwd "$MYUSER" | cut -d: -f6)}"
[[ -n $MYHOME ]] || { echo "cannot determine the home directory of $MYUSER" >&2; exit 1; }

if (( AM_ROOT )); then
  CONF_DIR="/etc/certpull"
else
  CONF_DIR="${XDG_CONFIG_HOME:-$MYHOME/.config}/certpull"
fi

CONF="${CERTPULL_AGENT_CONF:-}"

# --- multi-profile mode -----------------------------------------------------
if [[ -z $CONF ]]; then
  shopt -s nullglob
  profiles=( "$CONF_DIR"/agent.d/*.conf )
  if ((${#profiles[@]})); then
    rc=0
    for p in "${profiles[@]}"; do
      CERTPULL_AGENT_CONF="$p" "$0" "$@" || rc=1
    done
    exit "$rc"
  fi
  CONF="$CONF_DIR/agent.conf"
fi

[[ -r $CONF ]] || { echo "$CONF is missing" >&2; exit 1; }
# shellcheck source=/dev/null
source "$CONF"

: "${HOSTID:?}"
: "${SERVER_PORT:=22}"
# ssh (default) | https -- see the header.
: "${TRANSPORT:=ssh}"
TRANSPORT="${TRANSPORT,,}"
# https only: the base URL `certpull-host url <hostid>` printed on the server.
: "${CERT_URL:=}"
# https only: an explicit outbound proxy, for networks where that is the only
# way out. Equivalent to setting https_proxy in the unit's environment.
: "${PROXY:=}"

case "$TRANSPORT" in
  ssh)
    : "${SERVER:?SERVER is required with TRANSPORT=ssh}"
    ;;
  https)
    : "${CERT_URL:?CERT_URL is required with TRANSPORT=https (get it from: certpull-host url $HOSTID)}"
    CERT_URL="${CERT_URL%/}"
    # Not because the payload needs it -- it verifies itself against the local
    # private key -- but because a plain http:// URL here is far more likely to
    # be a typo than a decision.
    [[ $CERT_URL == https://* ]] || { echo "CERT_URL must start with https:// (got: $CERT_URL)" >&2; exit 1; }
    : "${SERVER:=}"
    ;;
  *)
    echo "TRANSPORT must be ssh or https (got: $TRANSPORT)" >&2; exit 1 ;;
esac

# --- defaults that depend on the mode ---------------------------------------
if (( AM_ROOT )); then
  : "${SSH_KEY:=/etc/certpull/id_ed25519}"
  : "${KNOWN_HOSTS:=/etc/certpull/known_hosts}"
  : "${DEST:=/etc/ssl/certpull}"
  : "${DEST_MODE:=0755}"
  : "${CERT_OWNER:=root:root}" "${KEY_OWNER:=root:root}"
  LOCK_DIR="/run/lock"
else
  : "${SSH_KEY:=$MYHOME/.ssh/id_ed25519}"
  : "${KNOWN_HOSTS:=$MYHOME/.ssh/known_hosts}"
  : "${DEST:=$MYHOME/certificates}"
  : "${DEST_MODE:=0700}"
  # without root we do not change ownership -- the files are ours anyway
  CERT_OWNER=""; KEY_OWNER=""
  LOCK_DIR="${XDG_RUNTIME_DIR:-$MYHOME/.cache/certpull}"
fi
: "${CERT_MODE:=0644}" "${KEY_MODE:=0600}"
: "${COMBINED:=no}" "${EXPECT_DOMAINS:=}" "${RELOAD_CMD:=}"
# pem    -> cert.pem chain.pem fullchain.pem privkey.pem   (default)
# crtkey -> <hostid>.crt (full chain) + <hostid>.key + <hostid>.chain.crt
: "${FILE_STYLE:=pem}"
# CSR mode. Empty = whatever the server says, which is the recommended setting:
# the server is the authority. Setting it to yes/no turns it into an assertion,
# so a mismatch becomes an error instead of a silent change of where the
# private key lives.
: "${CSR_MODE:=}"
# The key THIS machine generates for itself in CSR mode.
# ec256 | ec384 | rsa2048 | rsa4096
: "${AGENT_KEY_TYPE:=ec256}"

LOCK="$LOCK_DIR/certpull-agent.$(basename "$CONF" .conf).lock"

FORCE=0; CHECK=0; RLIST=0; SUBMIT_ONLY=0; ROTATE=0; PRINT_CSR=0
for a in "$@"; do
  case "$a" in
    --force) FORCE=1 ;;
    --check) CHECK=1 ;;
    --remote-list) RLIST=1 ;;
    --submit) SUBMIT_ONLY=1 ;;
    --print-csr) PRINT_CSR=1 ;;
    --rotate-key) ROTATE=1 ;;
    -h|--help) sed -n '2,45p' "$0"; exit 0 ;;
    *) echo "unknown option: $a" >&2; exit 2 ;;
  esac
done

log()  { printf '%s\n' "$*" >&2; logger -t certpull-agent -- "$*" 2>/dev/null || true; }
die()  {
  log "ERROR: $*"
  if [[ -n ${NOTIFY_CMD:-} ]]; then "$NOTIFY_CMD" "$HOSTID" "$*" || true; fi
  exit 1
}

# --- file names in the destination directory --------------------------------
if [[ ${FILE_STYLE,,} == crtkey ]]; then
  OUT_CERT="$HOSTID.leaf.crt"     # the leaf alone, rarely needed
  OUT_FULL="$HOSTID.crt"          # the one you point the service config at
  OUT_CHAIN="$HOSTID.chain.crt"
  OUT_KEY="$HOSTID.key"
  OUT_COMB="$HOSTID.pem"
else
  OUT_CERT="cert.pem"; OUT_FULL="fullchain.pem"; OUT_CHAIN="chain.pem"
  OUT_KEY="privkey.pem"; OUT_COMB="combined.pem"
fi
# In CSR mode the private key is generated here and lives at exactly the same
# path as in full mode, so a service configuration does not change when a host
# is switched between the two.
#
# A key that is still waiting for its first certificate -- or for a rotation to
# complete -- is kept beside the active one and promoted ONLY once a matching
# certificate has actually arrived. Promoting it any earlier would leave the
# service with a key and a certificate that do not belong together.
KEY_ACTIVE="$DEST/$OUT_KEY"
KEY_PENDING="$DEST/.pending.$OUT_KEY"

mkdir -p "$LOCK_DIR" 2>/dev/null || true
exec 9>"$LOCK"
flock -n 9 || { log "another instance is already running"; exit 0; }

SSH=()
HTTP=()
if [[ $TRANSPORT == ssh ]]; then
  SSH=( ssh
        -p "$SERVER_PORT"
        -i "$SSH_KEY"
        -o IdentitiesOnly=yes
        -o UserKnownHostsFile="$KNOWN_HOSTS"
        -o StrictHostKeyChecking=yes
        -o BatchMode=yes
        -o ConnectTimeout=15
        -o ServerAliveInterval=10
        -o ServerAliveCountMax=3
        "$SERVER" )
else
  command -v curl >/dev/null || { echo "TRANSPORT=https needs curl" >&2; exit 1; }
  if [[ -n $PROXY ]]; then export https_proxy="$PROXY" HTTPS_PROXY="$PROXY"; fi
  # --proto '=https' so a redirect cannot walk this down to plain HTTP, and no
  # -L at all: the published tree is static and a redirect would mean the URL
  # is wrong. Short timeouts with two retries suit a twice-daily timer.
  HTTP=( curl -fsS --proto '=https' --tlsv1.2
         --max-time 60 --connect-timeout 15 --retry 2 --retry-delay 3 )
fi

json() { sed -n "s/.*\"$1\":\"\([^\"]*\)\".*/\1/p"; }

http_get() {                 # $1 = file name under CERT_URL -> body on stdout
  "${HTTP[@]}" "$CERT_URL/$1"
}

spki_of_key() {
  [[ -s ${1:-} ]] || return 0
  openssl pkey -in "$1" -pubout -outform DER 2>/dev/null \
    | openssl dgst -sha256 -hex 2>/dev/null | sed 's/.*= *//'
}
spki_of_cert() {
  openssl x509 -in "$1" -noout -pubkey 2>/dev/null \
    | openssl pkey -pubin -outform DER 2>/dev/null \
    | openssl dgst -sha256 -hex 2>/dev/null | sed 's/.*= *//'
}

if (( RLIST )); then
  [[ $TRANSPORT == ssh ]] || die "--remote-list needs TRANSPORT=ssh (over https there is nothing to ask)"
  echo "hostids available to this key:"
  "${SSH[@]}" list || die "the server does not support 'list' (an old pull-shell?)"
  exit 0
fi

# Only the SSH transport has a key to read. That is the point of the other one.
if [[ $TRANSPORT == ssh ]]; then
  [[ -r $SSH_KEY ]] || die "cannot read the key $SSH_KEY (running as $MYUSER)"
fi

# --- 1. what the server says ------------------------------------------------
# "config" is asked FIRST and is the authority on the mode and the domains,
# because it reads the host file. meta.json cannot be trusted for that: it is a
# snapshot of the last publication, so right after a host is switched between
# modes it still describes the old one, and an agent believing it would keep
# running in the previous mode until the next renewal.
#
# config also carries the published fingerprint, so one round trip is enough --
# the same cost as the single "meta" call this used to make.
REMOTE_FP=""; REMOTE_NA=""; REMOTE_DOMAINS=""; REMOTE_SPKI=""; MODE=""; CSR_STATE=""

https_assert_no_private_key() {
  # Run on EVERY https cycle, not only when something is about to be installed.
  # A server publishing a private key is an emergency whether or not this agent
  # happens to want that certificate today, and every agent polling the
  # endpoint is a free detector for it.
  local f
  for f in privkey.pem combined.pem "$HOSTID.key"; do
    if "${HTTP[@]}" -o /dev/null -I "$CERT_URL/$f" >/dev/null 2>&1; then
      die "$CERT_URL is serving $f -- a private key must never be on this endpoint. Tell whoever runs the server, now."
    fi
  done
}

read_https_meta() {          # the published state, from meta.json over HTTPS
  local m
  if m=$(http_get meta.json 2>/dev/null); then
    REMOTE_FP=$(printf '%s' "$m" | json fingerprint_sha256)
    REMOTE_SPKI=$(printf '%s' "$m" | json spki_sha256)
    REMOTE_NA=$(printf '%s' "$m" | json not_after)
    # config.json's domain list wins: that is what the host is authorised for,
    # while meta.json describes whatever happened to be issued last.
    [[ -n $REMOTE_DOMAINS ]] || REMOTE_DOMAINS=$(printf '%s' "$m" | json domains)
  else
    # Normal before the first issuance: config.json exists from the moment the
    # host was added, meta.json only once something has been signed.
    REMOTE_FP=""; REMOTE_SPKI=""; REMOTE_NA=""
  fi
}

ask_config() {               # (re)read mode + domains + published state
  local out
  if [[ $TRANSPORT == https ]]; then
    # config.json is the HTTPS counterpart of the SSH "config" verb, and exists
    # for the same reason: an agent has to be able to learn which names it is
    # authorised for before anything has been issued for it.
    if ! out=$(http_get config.json 2>/dev/null); then
      die "cannot read $CERT_URL/config.json -- wrong CERT_URL or token? is WWW_BASE_URL set on the server? (certpull-host url $HOSTID)"
    fi
    MODE=$(printf '%s' "$out" | json mode)
    REMOTE_DOMAINS=$(printf '%s' "$out" | json domains)
    : "${MODE:=csr}"
    # Nothing served over this transport may contain a private key, so a server
    # claiming full mode here is either misconfigured or not the server we
    # think it is. Either way, do not proceed.
    [[ $MODE == csr ]] || die "$CERT_URL says mode=$MODE -- the HTTPS transport only ever serves CSR-mode bundles"
    # There is no stored-CSR state to report over a read-only transport; a
    # mismatch between config.json's domains and the certificate is caught by
    # the name check below instead.
    CSR_STATE=""
    https_assert_no_private_key
    read_https_meta
    return 0
  fi
  if ! out=$("${SSH[@]}" "config $HOSTID" 2>/dev/null); then
    if [[ ${CSR_MODE,,} == yes ]]; then
      die "this server does not know the 'config' verb -- it is too old for CSR mode (run install-server.sh --update there)"
    fi
    return 1
  fi
  MODE=$(printf '%s\n' "$out" | sed -n 's/^mode=//p' | head -1)
  REMOTE_DOMAINS=$(printf '%s\n' "$out" | sed -n 's/^domains=//p' | head -1)
  CSR_STATE=$(printf '%s\n' "$out" | sed -n 's/^csr_state=//p' | head -1)
  : "${MODE:=full}"
  if [[ $(printf '%s\n' "$out" | sed -n 's/^published=//p' | head -1) == yes ]]; then
    REMOTE_FP=$(printf '%s\n'   "$out" | sed -n 's/^fingerprint_sha256=//p' | head -1)
    REMOTE_SPKI=$(printf '%s\n' "$out" | sed -n 's/^spki_sha256=//p'        | head -1)
    REMOTE_NA=$(printf '%s\n'   "$out" | sed -n 's/^not_after=//p'          | head -1)
  else
    REMOTE_FP=""; REMOTE_SPKI=""; REMOTE_NA=""
  fi
  return 0
}

if ! ask_config; then
  # An old server, which only knows "meta". Such a server can only ever be in
  # full mode, since CSR mode did not exist there. Not reachable with
  # TRANSPORT=https, where ask_config either succeeds or dies.
  META=$("${SSH[@]}" "meta $HOSTID" 2>/dev/null) \
    || die "cannot reach $HOSTID on $SERVER (key? known_hosts? permission for this hostid? nothing published yet?)"
  REMOTE_FP=$(printf '%s' "$META" | json fingerprint_sha256)
  REMOTE_NA=$(printf '%s' "$META" | json not_after)
  REMOTE_DOMAINS=$(printf '%s' "$META" | json domains)
  REMOTE_SPKI=$(printf '%s' "$META" | json spki_sha256)
  MODE=$(printf '%s' "$META" | json mode)
  : "${MODE:=full}"
  [[ -n $REMOTE_FP ]] || die "meta.json without fingerprint_sha256"
fi

# A declared CSR_MODE is an assertion: it has to agree with the server, because
# the two modes differ in where the private key lives.
if [[ -n ${CSR_MODE//[[:space:]]/} ]]; then
  WANT_MODE=full; if [[ ${CSR_MODE,,} == yes ]]; then WANT_MODE=csr; fi
  if [[ $WANT_MODE != "$MODE" ]]; then
    die "mode mismatch: this agent is set to '$WANT_MODE' but the server runs $HOSTID in '$MODE' (fix CSR_MODE in $CONF, or CSR_MODE in the host file on the server)"
  fi
fi

# --- our own private key (CSR mode) -----------------------------------------
gen_key() {                  # $1 = destination file
  local out="$1" t="${AGENT_KEY_TYPE,,}" old_umask
  old_umask=$(umask); umask 077
  install -d -m "$DEST_MODE" "$DEST" 2>/dev/null || mkdir -p "$DEST"
  case "$t" in
    ec256)   openssl genpkey -algorithm EC  -pkeyopt ec_paramgen_curve:P-256 -out "$out.tmp" 2>/dev/null ;;
    ec384)   openssl genpkey -algorithm EC  -pkeyopt ec_paramgen_curve:P-384 -out "$out.tmp" 2>/dev/null ;;
    rsa2048) openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048    -out "$out.tmp" 2>/dev/null ;;
    rsa4096) openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:4096    -out "$out.tmp" 2>/dev/null ;;
    *) umask "$old_umask"; die "AGENT_KEY_TYPE=$AGENT_KEY_TYPE is not supported (ec256|ec384|rsa2048|rsa4096)" ;;
  esac
  umask "$old_umask"
  [[ -s $out.tmp ]] || die "could not generate a $AGENT_KEY_TYPE private key"
  chmod "$KEY_MODE" "$out.tmp"
  if [[ -n $KEY_OWNER ]]; then chown "$KEY_OWNER" "$out.tmp" || true; fi
  mv -f "$out.tmp" "$out"
  log "$HOSTID: generated a new $AGENT_KEY_TYPE private key -- it will not leave this machine"
}

build_csr() {                # $1 = key file, $2 = output CSR; uses REMOTE_DOMAINS
  local key="$1" out="$2" first sans d subj
  local -a names=()
  # REMOTE_DOMAINS arrives as "a.example.com, b.example.com".
  # read -ra rather than an unquoted expansion: the multi-profile block above
  # turns on nullglob, and a wildcard domain left unquoted is pathname-expanded
  # -- under nullglob it vanishes, so the CSR would quietly ask for fewer names
  # than the host is configured for.
  read -r -a names <<<"${REMOTE_DOMAINS//,/ }"
  (( ${#names[@]} )) || die "the server did not tell us any domains for $HOSTID"
  first="${names[0]}"
  sans=""
  for d in "${names[@]}"; do sans+="DNS:$d,"; done
  sans="${sans%,}"
  # A CN is limited to 64 characters. When the first name does not fit we leave
  # the subject empty: lego then takes the first DNS SAN as the main domain, and
  # openssl preserves the SAN order we pass here, so it ends up being the same
  # name -- which is what the server expects the files to be called.
  if (( ${#first} <= 64 )); then subj="/CN=$first"; else subj="/"; fi
  openssl req -new -key "$key" -subj "$subj" -addext "subjectAltName=$sans" -out "$out" 2>/dev/null \
    || die "could not build a CSR for $REMOTE_DOMAINS"
}

print_csr() {                # $1 = key file -> the CSR on stdout
  local key="$1" csr
  csr=$(mktemp "${TMPDIR:-/tmp}/certpull-csr.XXXXXX")
  build_csr "$key" "$csr"
  cat "$csr"
  rm -f "$csr"
}

submit_csr() {               # $1 = key file to request a certificate for
  local key="$1" csr out
  if [[ $TRANSPORT != ssh ]]; then
    # Deliberate: the HTTPS endpoint is anonymous and read-only. Accepting a
    # CSR there would mean authenticating the writer, which is exactly the
    # problem this transport exists to avoid. Enrolment is a one-time step.
    log "$HOSTID: a new CSR is needed, but TRANSPORT=https has no way to send one."
    log "          here:        certpull-agent --print-csr > $HOSTID.csr"
    log "          the server:  certpull-host csr-import $HOSTID $HOSTID.csr"
    log "                       certpull-issue $HOSTID"
    return 1
  fi
  csr=$(mktemp "${TMPDIR:-/tmp}/certpull-csr.XXXXXX")
  build_csr "$key" "$csr"
  if out=$("${SSH[@]}" "submit $HOSTID" < "$csr" 2>&1); then
    rm -f "$csr"
    log "$HOSTID: $out"
  else
    rm -f "$csr"
    die "the server rejected the CSR: $out"
  fi
}

installed_mode() {           # the mode of what is currently in DEST, or empty
  [[ -s $DEST/meta.json ]] || return 0
  local m; m=$(json mode < "$DEST/meta.json")
  printf '%s' "${m:-full}"
}

MATCH=""; WANT_KEY=""; NEED_SUBMIT=0; ACT_SPKI=""; PEN_SPKI=""
if [[ $MODE == csr ]]; then
  PREV_MODE="$(installed_mode)"

  if (( ! CHECK )); then
    if (( ROTATE )); then
      gen_key "$KEY_PENDING"
    elif [[ -s $KEY_PENDING ]]; then
      # A pending key already exists, so leave it alone. This guard is what
      # makes the thing converge: the conditions below stay true until a
      # matching certificate has been installed, and without it every run
      # would throw the previous pending key away, submit a CSR for a brand
      # new one, and never accept the certificate signed for the last one.
      :
    elif [[ -n $PREV_MODE && $PREV_MODE != csr && -s $KEY_ACTIVE ]]; then
      # Switched from full to CSR mode. The key currently on disk came FROM the
      # server, so keeping it would defeat the whole point of the move: a copy
      # of it has already existed somewhere else. Start a fresh one.
      log "$HOSTID: switched from $PREV_MODE to csr mode -- the old key came from the server, generating a fresh one"
      gen_key "$KEY_PENDING"
    elif [[ ! -s $KEY_ACTIVE ]]; then
      gen_key "$KEY_PENDING"
    fi
  fi

  ACT_SPKI=$(spki_of_key "$KEY_ACTIVE")
  PEN_SPKI=$(spki_of_key "$KEY_PENDING")
  if [[ -n $PEN_SPKI ]]; then WANT_KEY="$KEY_PENDING"; else WANT_KEY="$KEY_ACTIVE"; fi

  # Which of our keys, if any, does the published certificate belong to?
  # Only a key we actually hold can produce an installable certificate.
  if [[ -n $REMOTE_SPKI ]]; then
    if   [[ -n $PEN_SPKI && $REMOTE_SPKI == "$PEN_SPKI" ]]; then MATCH="$KEY_PENDING"
    elif [[ -n $ACT_SPKI && $REMOTE_SPKI == "$ACT_SPKI" ]]; then MATCH="$KEY_ACTIVE"
    fi
  fi

  if [[ -z $MATCH || $REMOTE_SPKI != "$(spki_of_key "$WANT_KEY")" ]]; then NEED_SUBMIT=1; fi
  # The server says the CSR on file no longer matches the configured DOMAINS.
  # Nothing local would reveal that: the installed key and certificate are a
  # perfectly matching pair, they just cover the wrong set of names now.
  if [[ $CSR_STATE == stale || $CSR_STATE == missing ]]; then
    if [[ $CSR_STATE == stale ]]; then
      log "$HOSTID: the server reports the stored CSR no longer matches its DOMAINS -- sending a new one"
    fi
    NEED_SUBMIT=1
  fi
fi

# --- 2. local fingerprint ---------------------------------------------------
LOCAL_FP=""
if [[ -s $DEST/$OUT_FULL ]]; then
  LOCAL_FP=$(openssl x509 -in "$DEST/$OUT_FULL" -noout -fingerprint -sha256 2>/dev/null | cut -d= -f2 || true)
fi

if (( CHECK )); then
  mode_note="$MODE"
  if [[ $MODE == csr ]]; then mode_note="$MODE (the private key stays on this machine)"; fi
  echo "profile:   $(basename "$CONF")"
  echo "user:      $MYUSER"
  echo "host:      $HOSTID"
  if [[ $TRANSPORT == https ]]; then
    echo "transport: https (anonymous GET, no SSH key needed)"
    echo "url:       $CERT_URL"
  else
    echo "transport: ssh ($SERVER)"
  fi
  echo "mode:      $mode_note"
  echo "domains:   $REMOTE_DOMAINS"
  echo "expires:   ${REMOTE_NA:-(nothing published)}"
  echo "directory: $DEST  (style: $FILE_STYLE -> $OUT_FULL + $OUT_KEY)"
  echo "remote fp: ${REMOTE_FP:-(none)}"
  echo "local fp:  ${LOCAL_FP:-(none)}"
  if [[ $MODE == csr ]]; then
    if [[ -n $ACT_SPKI ]]; then echo "key:       active  $ACT_SPKI"
    else                        echo "key:       (none yet -- the next run generates one)"; fi
    if [[ -n $PEN_SPKI ]]; then echo "           pending $PEN_SPKI -- waiting for a certificate"; fi
  fi
  if   (( NEED_SUBMIT )) && [[ $TRANSPORT == https ]]; then
                                             echo "state:     NEEDS ENROLMENT (certpull-agent --print-csr, then csr-import on the server)"
  elif [[ -z $REMOTE_FP ]];             then echo "state:     WAITING (nothing published for this host yet)"
  elif (( NEED_SUBMIT ));               then echo "state:     NEEDS A CSR SUBMISSION (certpull-agent --submit)"
  elif [[ $LOCAL_FP == "$REMOTE_FP" ]]; then echo "state:     up to date"
  else                                       echo "state:     NEEDS UPDATE"
  fi
  exit 0
fi

if (( PRINT_CSR )); then
  [[ $MODE == csr ]] || die "$HOSTID is in full mode -- there is no CSR to print"
  if [[ ! -s ${WANT_KEY:-/nonexistent} ]]; then WANT_KEY="$KEY_PENDING"; gen_key "$KEY_PENDING"; fi
  print_csr "$WANT_KEY"
  log "$HOSTID: CSR for $(basename "$WANT_KEY") ($(spki_of_key "$WANT_KEY"))"
  log "          on the server:  certpull-host csr-import $HOSTID <file> && certpull-issue $HOSTID"
  exit 0
fi

if (( SUBMIT_ONLY )); then
  [[ $MODE == csr ]] || die "$HOSTID is in full mode -- there is no CSR to submit"
  if [[ $TRANSPORT != ssh ]]; then
    die "TRANSPORT=https cannot submit -- use --print-csr and certpull-host csr-import on the server"
  fi
  # No refresh needed: MODE and REMOTE_DOMAINS already came from the host file
  # through "config" a moment ago, which is the authoritative source.
  if [[ ! -s ${WANT_KEY:-/nonexistent} ]]; then WANT_KEY="$KEY_PENDING"; gen_key "$KEY_PENDING"; fi
  submit_csr "$WANT_KEY"
  log "$HOSTID: CSR sent. The certificate appears after the server's next renewal run"
  log "         (or straight away:  certpull-issue $HOSTID   -- on the server)"
  exit 0
fi

# --- 3. is there anything to install? ---------------------------------------
INSTALL=0
if [[ -n $REMOTE_FP ]]; then
  if [[ $MODE == csr && -z $MATCH ]]; then
    # Published, but for a key we do not hold -- usually a rotation that has not
    # been signed yet. Nothing to install; the submission below handles it.
    INSTALL=0
  elif [[ $LOCAL_FP != "$REMOTE_FP" ]] || (( FORCE )); then
    INSTALL=1
  fi
fi

if (( ! INSTALL && ! NEED_SUBMIT )); then
  log "$HOSTID: up to date (valid until $REMOTE_NA)"
  exit 0
fi

do_install() {
  local f n A B
  TMP=$(mktemp -d "${TMPDIR:-/tmp}/certpull.XXXXXX")
  chmod 0700 "$TMP"
  cleanup() { rm -rf "$TMP"; }
  trap cleanup EXIT

  log "$HOSTID: fetching a new certificate over $TRANSPORT ($REMOTE_FP)"
  if [[ $TRANSPORT == https ]]; then
    # One file at a time rather than an archive: the published tree is static,
    # and SHA256SUMS still has to account for every one of them, so a partial
    # or swapped download cannot get past the checks below.
    for f in SHA256SUMS meta.json cert.pem chain.pem fullchain.pem; do
      http_get "$f" > "$TMP/$f" 2>/dev/null \
        || die "cannot download $CERT_URL/$f"
    done
    # Checked again here, immediately before anything is written: cheap, and it
    # covers the window since the check at the start of the run.
    https_assert_no_private_key
  else
    "${SSH[@]}" "fetch $HOSTID" > "$TMP/bundle.tar" || die "the download failed"
    tar -C "$TMP" -xf "$TMP/bundle.tar" || die "corrupt archive"
    rm -f "$TMP/bundle.tar"
  fi

  # --- 4. verification (nothing lands in the destination before this step) ---
  ( cd "$TMP" && sha256sum -c --status SHA256SUMS ) || die "checksums do not match"

  local -a need=( cert.pem fullchain.pem )
  if [[ $MODE != csr ]]; then need+=( privkey.pem ); fi
  for f in "${need[@]}"; do
    [[ -s $TMP/$f ]] || die "$f is missing or empty"
  done
  if [[ $MODE == csr && -e $TMP/privkey.pem ]]; then
    die "the server sent a private key for a host in CSR mode -- refusing to touch it"
  fi

  GOT_FP=$(openssl x509 -in "$TMP/cert.pem" -noout -fingerprint -sha256 | cut -d= -f2)
  [[ $GOT_FP == "$REMOTE_FP" ]] || die "the fingerprint of the downloaded cert does not match meta.json"

  if [[ $MODE == csr ]]; then
    # THE check of this mode: the certificate must belong to the private key
    # that never left this machine. Neither the transport nor the server has to
    # be trusted for that to hold -- only Let's Encrypt and the local key.
    A=$(spki_of_cert "$TMP/cert.pem")
    B=$(spki_of_key "$MATCH")
    [[ -n $A && $A == "$B" ]] \
      || die "the downloaded certificate does not match the local private key -- not installing it"
  else
    A=$(openssl x509 -in "$TMP/cert.pem" -noout -pubkey | openssl sha256)
    B=$(openssl pkey -in "$TMP/privkey.pem" -pubout | openssl sha256)
    [[ $A == "$B" ]] || die "the private key does not match the certificate"
  fi

  openssl x509 -in "$TMP/cert.pem" -noout -checkend 86400 >/dev/null \
    || die "the certificate expires within 24h or has already expired -- not installing it"

  openssl verify -untrusted "$TMP/fullchain.pem" "$TMP/cert.pem" >/dev/null 2>&1 \
    || log "warning: openssl verify could not confirm the chain (LE staging? a private CA?)"

  # Same reason as above for read -ra. A wildcard name is checked against a
  # label under it, because openssl's -checkhost does not treat the bare parent
  # name as covered by *.parent -- and it is not.
  local -a cnames=()
  read -r -a cnames <<<"${EXPECT_DOMAINS:-${REMOTE_DOMAINS//,/ }}"
  for n in "${cnames[@]}"; do
    local probe="$n"
    if [[ $n == \*.* ]]; then probe="certpull-wildcard-probe.${n#\*.}"; fi
    openssl x509 -in "$TMP/cert.pem" -noout -checkhost "$probe" >/dev/null 2>&1 \
      || die "the certificate does not cover the name $n"
  done

  # --- 5. installation ------------------------------------------------------
  install -d -m "$DEST_MODE" "$DEST" 2>/dev/null || mkdir -p "$DEST"
  [[ -w $DEST ]] || die "no write permission for $DEST (running as $MYUSER)"

  BACKUP="$DEST/.previous"
  rm -rf "$BACKUP"
  if [[ -s $DEST/$OUT_FULL ]]; then
    install -d -m 0700 "$BACKUP"
    for f in "$OUT_CERT" "$OUT_FULL" "$OUT_CHAIN" "$OUT_KEY" "$OUT_COMB"; do
      [[ -e $DEST/$f ]] && cp -a "$DEST/$f" "$BACKUP/" || true
    done
  fi

  if [[ ${COMBINED,,} == yes ]]; then
    if [[ $MODE == csr ]]; then
      cat "$TMP/fullchain.pem" "$MATCH" > "$TMP/combined.pem"
    else
      cat "$TMP/fullchain.pem" "$TMP/privkey.pem" > "$TMP/combined.pem"
    fi
  fi

  put() {                    # $1=source file in TMP  $2=target name  $3=owner  $4=mode
    local src="$TMP/$1" dst="$DEST/$2" owner="$3" mode="$4"
    [[ -s $src ]] || return 0
    local -a args=( -m "$mode" )
    if [[ -n $owner ]]; then args+=( -o "${owner%%:*}" -g "${owner##*:}" ); fi
    install "${args[@]}" "$src" "$DEST/.new.$2"
    mv -f "$DEST/.new.$2" "$dst"
  }

  # The key is promoted first: between it and the certificates there must be no
  # window in which a reload could pick up a mismatched pair. Both are renames
  # inside one directory, so each is atomic, and RELOAD_CMD only runs at the end.
  if [[ $MODE == csr && $MATCH == "$KEY_PENDING" ]]; then
    install -m "$KEY_MODE" "$KEY_PENDING" "$DEST/.new.$OUT_KEY"
    if [[ -n $KEY_OWNER ]]; then chown "$KEY_OWNER" "$DEST/.new.$OUT_KEY" || true; fi
    mv -f "$DEST/.new.$OUT_KEY" "$KEY_ACTIVE"
    rm -f "$KEY_PENDING"
    MATCH="$KEY_ACTIVE"
    log "$HOSTID: the new private key is now the active one"
  fi

  put cert.pem      "$OUT_CERT"  "$CERT_OWNER" "$CERT_MODE"
  put fullchain.pem "$OUT_FULL"  "$CERT_OWNER" "$CERT_MODE"
  put chain.pem     "$OUT_CHAIN" "$CERT_OWNER" "$CERT_MODE"
  if [[ $MODE != csr ]]; then
    put privkey.pem "$OUT_KEY"   "$KEY_OWNER"  "$KEY_MODE"
    # A key this agent had generated for a CSR-mode run is meaningless now that
    # the server supplies one again; leaving it behind would make a later
    # switch back to CSR mode silently reuse a key of unclear age.
    if [[ -e $KEY_PENDING ]]; then
      shred -u "$KEY_PENDING" 2>/dev/null || rm -f "$KEY_PENDING"
    fi
  fi
  put combined.pem  "$OUT_COMB"  "$KEY_OWNER"  "$KEY_MODE"
  put meta.json     "meta.json"  "$CERT_OWNER" "0644"

  # --- 6. service reload ----------------------------------------------------
  # With a dedicated user, RELOAD_CMD usually needs passwordless sudo, e.g.
  #   RELOAD_CMD="sudo -n /usr/bin/systemctl reload nginx"
  # with a rule in /etc/sudoers.d/certpull-agent restricted to that one command.
  if [[ -n $RELOAD_CMD ]]; then
    if bash -c "$RELOAD_CMD"; then
      log "$HOSTID: installed into $DEST and reloaded (valid until $REMOTE_NA)"
    else
      log "the reload failed -- rolling back to the previous certificate"
      if [[ -d $BACKUP ]]; then
        cp -a "$BACKUP"/. "$DEST"/ 2>/dev/null || true
        bash -c "$RELOAD_CMD" || log "the rollback did not reload the service either -- NEEDS ATTENTION"
      fi
      die "RELOAD_CMD returned an error"
    fi
  else
    log "$HOSTID: installed into $DEST (valid until $REMOTE_NA), no RELOAD_CMD"
  fi
}

# Called plainly, NOT as `do_install || ...`: that would switch off set -e for
# the whole function body and a failing step would be reported as success.
if (( INSTALL )); then do_install; fi

# --- 7. ask for a certificate on the key we hold ----------------------------
# Deliberately last: if a renewal was waiting for the key currently in use, it
# gets installed first, and only then does the next rotation start.
if (( NEED_SUBMIT )); then
  if [[ ! -s ${WANT_KEY:-/nonexistent} ]]; then WANT_KEY="$KEY_PENDING"; gen_key "$KEY_PENDING"; fi
  if submit_csr "$WANT_KEY"; then
    if [[ -z $REMOTE_FP ]]; then
      log "$HOSTID: CSR sent, waiting for the first certificate"
    else
      log "$HOSTID: CSR sent for the new key; the current certificate stays in use until it is signed"
    fi
  else
    # Over HTTPS this is not a failure of this run: the certificate currently
    # installed is still valid and still in use, and enrolment is a human step
    # whose instructions submit_csr has just printed. Exiting non-zero would
    # paint the timer red every twelve hours until somebody did it.
    [[ $TRANSPORT == ssh ]] && die "could not submit the CSR" || true
  fi
fi

exit 0
